---
import Layout from '../layouts/Layout.astro';
import { getHistorial, getRendimientoGeneral, formatearFecha } from '../data/predictions';

const historial = getHistorial();
const r = getRendimientoGeneral();

const badgeResultado: Record<string, string> = {
  ganada: 'bg-green-500/15 text-green-400 border-green-500/30',
  perdida: 'bg-red-500/15 text-red-400 border-red-500/30',
  pendiente: 'bg-yellow-500/15 text-yellow-400 border-yellow-500/30',
};
const textoResultado: Record<string, string> = {
  ganada: '✔ Ganada',
  perdida: '✘ Perdida',
  pendiente: '⏳ Pendiente',
};
---

<Layout>
  <section class="py-8 sm:py-12">

    <!-- Encabezado -->
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-[clamp(1.75rem,5vw,2.5rem)] font-bold text-white">
          Historial de pronósticos
        </h1>
        <p class="mt-2 max-w-xl text-sm sm:text-base text-slate-400">
          Registro completo de las apuestas deportivas publicadas por nuestros
          administradores. Transparencia total: ganadas, perdidas y pendientes.
        </p>
      </div>

      <a
        href="/#rendimiento"
        class="inline-flex w-fit items-center gap-2 rounded-xl border border-slate-700 px-4 py-3 text-sm font-semibold text-white transition hover:border-green-500 hover:text-green-400 active:border-green-500"
      >
        Volver al rendimiento general
      </a>
    </div>

    <!-- Resumen rápido -->
    <div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-2xl border border-slate-800 bg-[#07111d]/60 p-4 text-center">
        <p class="text-xs uppercase tracking-wide text-slate-500">Totales</p>
        <p class="mt-1 text-2xl font-bold text-white">{r.cerradas + r.pendientes}</p>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-[#07111d]/60 p-4 text-center">
        <p class="text-xs uppercase tracking-wide text-slate-500">Ganadas</p>
        <p class="mt-1 text-2xl font-bold text-green-500">{r.ganadas}</p>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-[#07111d]/60 p-4 text-center">
        <p class="text-xs uppercase tracking-wide text-slate-500">Perdidas</p>
        <p class="mt-1 text-2xl font-bold text-red-500">{r.perdidas}</p>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-[#07111d]/60 p-4 text-center">
        <p class="text-xs uppercase tracking-wide text-slate-500">Win Rate</p>
        <p class="mt-1 text-2xl font-bold text-white">{r.winRate.toFixed(1)}%</p>
      </div>
    </div>

    <!-- Tabla (desktop) / Cards (móvil) -->
    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-[#07111d]/60">

      <!-- Vista tabla: md en adelante -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-xs uppercase tracking-wider text-slate-500">
              <th class="px-4 py-3 font-semibold">Fecha</th>
              <th class="px-4 py-3 font-semibold">Partido</th>
              <th class="px-4 py-3 font-semibold">Liga</th>
              <th class="px-4 py-3 font-semibold">Pronóstico</th>
              <th class="px-4 py-3 font-semibold text-center">Cuota</th>
              <th class="px-4 py-3 font-semibold text-center">Confianza</th>
              <th class="px-4 py-3 font-semibold">Admin</th>
              <th class="px-4 py-3 font-semibold text-center">Resultado</th>
            </tr>
          </thead>
          <tbody>
            {historial.map((a) => (
              <tr class="border-b border-slate-800/60 last:border-0 hover:bg-white/[0.03] transition">
                <td class="whitespace-nowrap px-4 py-3 text-slate-400">
                  {formatearFecha(a.fecha)} · {a.hora}
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <img src={a.logoLocal} alt="" class="h-6 w-6 object-contain" />
                    <span class="text-white font-medium">{a.equipoLocal} vs {a.equipoVisitante}</span>
                    <img src={a.logoVisitante} alt="" class="h-6 w-6 object-contain" />
                  </div>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-400">{a.liga}</td>
                <td class="px-4 py-3 text-white">{a.pronostico}</td>
                <td class="px-4 py-3 text-center font-semibold text-green-400">{a.cuota.toFixed(2)}</td>
                <td class="px-4 py-3 text-center text-slate-300">{a.confianza}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-400">{a.admin}</td>
                <td class="px-4 py-3 text-center">
                  <span class={`inline-block rounded-full border px-3 py-1 text-xs font-semibold ${badgeResultado[a.resultado]}`}>
                    {textoResultado[a.resultado]}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Vista cards: móvil -->
      <ul class="divide-y divide-slate-800 md:hidden">
        {historial.map((a) => (
          <li class="p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <img src={a.logoLocal} alt={a.equipoLocal} class="h-8 w-8 object-contain" />
                  <img src={a.logoVisitante} alt={a.equipoVisitante} class="h-8 w-8 object-contain" />
                  <span class="truncate font-semibold text-white">
                    {a.equipoLocal} vs {a.equipoVisitante}
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-500">
                  {a.liga} • {formatearFecha(a.fecha)} • {a.hora} • por {a.admin}
                </p>
              </div>
              <span class={`shrink-0 rounded-full border px-3 py-1 text-xs font-semibold ${badgeResultado[a.resultado]}`}>
                {textoResultado[a.resultado]}
              </span>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              <span class="text-white font-medium">{a.pronostico}</span>
              <span class="text-green-400 font-bold">Cuota {a.cuota.toFixed(2)}</span>
              <span class="text-slate-400">Confianza: {a.confianza}</span>
              <span class="text-slate-500">Stake: {a.unidades} U</span>
            </div>
          </li>
        ))}
      </ul>

    </div>

    <p class="mt-6 text-center text-xs text-slate-500">
      ¿Eres administrador? Registra nuevas apuestas en el
      <a href="/admin" class="text-green-500 hover:text-green-400">panel de administración</a>.
    </p>
  </section>
</Layout>
