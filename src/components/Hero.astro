<section class="mx-auto max-w-7xl px-4 py-12">
  <div class="grid gap-8 lg:grid-cols-2">

    <!-- Lado izquierdo -->
    <div class="flex flex-col justify-center">

      <h1 class="text-5xl font-bold leading-tight md:text-6xl">
        <span class="text-white">Decisiones,</span>
        <br />
        <span class="text-green-500">no impulsos.</span>
      </h1>

      <p class="mt-6 max-w-lg text-lg text-slate-400">
        Análisis, disciplina y gestión del riesgo para tomar
        decisiones con ventaja.
      </p>

      <blockquote class="mt-10 border-l-4 border-green-500 pl-4 italic text-slate-300">
        "Quien apuesta por necesidad, pierde por obligación."
      </blockquote>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row">

        <button
          class="rounded-xl bg-green-500 px-6 py-4 font-semibold text-black transition hover:bg-green-400"
        >
          Ver pronósticos
        </button>

        <button
          class="rounded-xl border border-slate-700 px-6 py-4 font-semibold text-white transition hover:border-slate-500"
        >
          Ver resultados
        </button>

      </div>

    </div>

    <!-- Dashboard -->
    <div class="rounded-3xl border border-slate-800 bg-[#07111d]/90 p-6 backdrop-blur">

      <div class="mb-6 flex items-center justify-between">

        <h2 class="text-2xl font-bold text-white">
          Rendimiento general
        </h2>

        <select
          class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-300"
        >
          <option>Este mes</option>
          <option>Últimos 3 meses</option>
          <option>Este año</option>
        </select>

      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">

        <div class="rounded-2xl border border-slate-800 p-4">
          <p class="text-sm text-slate-400">ROI</p>
          <p class="mt-2 text-3xl font-bold text-green-500">
            +18.45%
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 p-4">
          <p class="text-sm text-slate-400">Win Rate</p>
          <p class="mt-2 text-3xl font-bold text-green-500">
            61.3%
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 p-4">
          <p class="text-sm text-slate-400">Pronósticos</p>
          <p class="mt-2 text-3xl font-bold text-white">
            142
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 p-4">
          <p class="text-sm text-slate-400">Beneficio</p>
          <p class="mt-2 text-3xl font-bold text-green-500">
            +235.6 U
          </p>
        </div>

      </div>

      <!-- Gráficos -->
      <div class="mt-6 grid gap-4 lg:grid-cols-2">

        <!-- ROI -->
        <div class="rounded-2xl border border-slate-800 p-5">
          <h3 class="mb-4 text-lg font-semibold text-white">
            Evolución ROI
          </h3>

          <div
            class="flex h-64 items-center justify-center rounded-xl bg-slate-900"
          >
            <span class="text-slate-500">
              Aquí irá Chart.js / ApexCharts
            </span>
          </div>
        </div>

        <!-- Donut -->
        <div class="rounded-2xl border border-slate-800 p-5">
          <h3 class="mb-4 text-lg font-semibold text-white">
            Distribución de resultados
          </h3>

          <div
            class="flex h-64 items-center justify-center rounded-xl bg-slate-900"
          >
            <span class="text-slate-500">
              Aquí irá gráfico Donut
            </span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>