---
import { formatearFecha } from '../data/predictions';
import type { Apuesta } from '../data/predictions';

interface Props {
  apuesta: Apuesta;
}

const { apuesta } = Astro.props;
const a = apuesta;

const barrasConfianza: Record<string, number> = { ALTA: 3, MEDIA: 2, BAJA: 1 };
const barras = barrasConfianza[a.confianza] ?? 1;
---

<div class="w-full max-w-6xl mx-auto">
  <div
    class="relative overflow-hidden rounded-2xl border border-green-500/40 bg-gradient-to-r from-[#07121f] via-[#081524] to-[#07121f] p-4 md:p-6"
  >
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">

      <!-- Partido -->
      <div class="flex flex-col gap-4 min-w-0 lg:w-1/3">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-green-400 text-xs font-semibold uppercase">
          <span class="inline-flex items-center gap-2">⭐ Pronóstico destacado</span>
          <span class="text-slate-500 normal-case">por <strong class="text-slate-300">{a.admin}</strong></span>
        </div>

        <div class="flex items-center justify-center gap-3 sm:gap-4">
          <img src={a.logoLocal} alt={a.equipoLocal} class="h-12 w-12 sm:h-14 sm:w-14 md:h-20 md:w-20 object-contain" />
          <span class="text-white font-bold text-lg">VS</span>
          <img src={a.logoVisitante} alt={a.equipoVisitante} class="h-12 w-12 sm:h-14 sm:w-14 md:h-20 md:w-20 object-contain" />
        </div>

        <div class="text-center lg:text-left">
          <h3 class="text-white font-semibold text-lg">{a.equipoLocal} vs {a.equipoVisitante}</h3>
          <p class="text-gray-400 text-sm mt-1">{a.liga} • {formatearFecha(a.fecha)} • {a.hora}</p>
        </div>
      </div>

      <!-- Separador Desktop -->
      <div class="hidden lg:block h-24 w-px bg-white/10"></div>

      <!-- Pronóstico -->
      <div class="min-w-0 text-center lg:text-left lg:w-1/3">
        <h2 class="text-white text-2xl md:text-3xl font-bold break-words">{a.pronostico}</h2>
        <p class="text-gray-500 uppercase text-xs tracking-wider mt-2">{a.tipoApuesta}</p>

        <div class="mt-4 inline-flex items-center gap-3 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-2">
          <span class="text-green-400 font-medium">Confianza: {a.confianza}</span>
          <div class="flex items-end gap-1" aria-hidden="true">
            {Array.from({ length: barras }).map(() => (
              <span class="w-2 h-7 bg-green-500 rounded"></span>
            ))}
          </div>
        </div>
      </div>

      <!-- Separador Desktop -->
      <div class="hidden lg:block h-24 w-px bg-white/10"></div>

      <!-- Cuota -->
      <div class="min-w-0 text-center lg:w-1/4">
        <p class="text-gray-500 uppercase text-xs tracking-wider">Cuota</p>
        <div class="text-green-400 text-4xl sm:text-5xl font-bold mt-2">{a.cuota.toFixed(2)}</div>

        <button
          class="text-sm sm:text-xs mt-4 w-full lg:w-auto rounded-xl bg-green-500 px-6 sm:px-8 py-3 font-semibold text-black transition hover:bg-green-400 active:bg-green-400"
        >
          {a.comentario} ¡Apuesta ahora!
        </button>
      </div>

    </div>
  </div>
</div>
