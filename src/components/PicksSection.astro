---
import { getApuestasActivas } from '../data/predictions';
import PredCardFeatured from './PredCardFeatured.astro';
import PredCardSecondary from './PredCardSecondary.astro';

const activas = getApuestasActivas();
const destacada = activas.find((a) => a.nivel === 'destacado') ?? activas[0];
const sinDestacar = activas.filter((a) => a !== destacada);
// Se toman como máximo 2 secundarias y 3 terciarias: así el layout del inicio
// siempre queda completo (con jugadas cerradas no se distorsiona la grilla).
const secundarias = sinDestacar.filter((a) => a.nivel === 'secundario').slice(0, 2);
const terciarias = sinDestacar
  .filter((a) => a.nivel !== 'secundario' || secundarias.length < 2)
  .slice(0, 3);
---

<section class="mb-8" id="picks">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">Pronósticos del día</h2>
    <p class="text-sm text-slate-400">
      Registrados por nuestro equipo de analistas · <a href="/admin" class="text-green-500 hover:text-green-400">Panel admin</a>
    </p>
  </div>

  {destacada && <PredCardFeatured apuesta={destacada} />}

  {secundarias.length > 0 && (
    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
      {secundarias.map((apuesta) => (
        <PredCardSecondary apuesta={apuesta} acento="sky" />
      ))}
    </div>
  )}

  {terciarias.length > 0 && (
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 pb-5">
      {terciarias.map((apuesta) => (
        <PredCardSecondary apuesta={apuesta} acento="purple" />
      ))}
    </div>
  )}
</section>

