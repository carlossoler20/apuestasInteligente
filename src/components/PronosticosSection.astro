---
// src/components/PronosticosSection.astro
// Ejemplo de uso de los componentes BetCardFeatured y BetCard
import BetCardFeatured from './BetCardFeatured.astro';
import BetCard from './BetCard.astro';
---

<section class="p-6 font-sans">

  <!-- Header -->
  <div class="flex justify-center items-center mb-4">
    <h2 class="text-verde-oscuro text-3xl font-semibold">Directa</h2>
    <!-- <a href="/pronosticos" class="text-[#0B3D2E] text-sm hover:text-[#0A2D24] transition-colors">
      Ver todos los pronósticos →
    </a> -->
  </div>

  <!-- Carta destacada -->
  <BetCardFeatured
    homeTeam="Real Madrid"
    awayTeam="Real Betis"
    homeCode="RM"
    awayCode="RB"
    homeColor="#1e3a8a"
    awayColor="#166534"
    betType="Más de 2.5 goles"
    league="LaLiga"
    date="25 Mayo"
    time="16:00"
    confianza="ALTA"
    cuota={1.25}
    href="/analisis/real-madrid-real-betis"
  />
  <br>
  <br>
  <!-- Cartas secundarias -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
    <BetCard
      variant="SECUNDARIO"
      homeTeam="Inter"
      awayTeam="Napoli"
      homeCode="INT"
      awayCode="NAP"
      homeColor="#1e3a8a"
      awayColor="#4f46e5"
      betType="Inter gana"
      league="Serie A"
      date="25 Mayo"
      time="20:45"
      confianza="MEDIA"
      cuota={1.95}
      href="/analisis/inter-napoli"
    />
    <BetCard
      variant="SECUNDARIO"
      homeTeam="Leverkusen"
      awayTeam="Dortmund"
      homeCode="LEV"
      awayCode="BVB"
      homeColor="#dc2626"
      awayColor="#f59e0b"
      betType="Ambos anotan"
      league="Bundesliga"
      date="25 Mayo"
      time="15:30"
      confianza="ALTA"
      cuota={1.72}
      href="/analisis/leverkusen-dortmund"
    />
  </div>
  
  <!-- Más pronósticos header -->
  <h2 class="text-white text-lg font-semibold mb-4">Más pronósticos</h2>

  <!-- Cartas terciarias -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <BetCard
      variant="TERCIARIO"
      homeTeam="Arsenal"
      awayTeam="Chelsea"
      homeCode="ARS"
      awayCode="CHE"
      homeColor="#dc2626"
      awayColor="#1e3a8a"
      betType="Más de 1.5 goles"
      league="Premier League"
      date="25 Mayo"
      time="17:00"
      cuota={1.40}
      href="/analisis/arsenal-chelsea"
    />
    <BetCard
      variant="TERCIARIO"
      homeTeam="PSG"
      awayTeam="Lyon"
      homeCode="PSG"
      awayCode="LYO"
      homeColor="#1e3a8a"
      awayColor="#dc2626"
      betType="PSG gana"
      league="Ligue 1"
      date="25 Mayo"
      time="19:00"
      cuota={1.60}
      href="/analisis/psg-lyon"
    />
    <BetCard
      variant="TERCIARIO"
      homeTeam="Juventus"
      awayTeam="Milan"
      homeCode="JUV"
      awayCode="MIL"
      homeColor="#374151"
      awayColor="#dc2626"
      betType="Menos de 3.5 goles"
      league="Serie A"
      date="25 Mayo"
      time="18:00"
      cuota={1.55}
      href="/analisis/juventus-milan"
    />
  </div>
  <br>
</section>
