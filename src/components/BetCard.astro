---
interface Props {
  variant: 'SECUNDARIO' | 'TERCIARIO';
  homeTeam: string;
  awayTeam: string;
  homeCode: string;
  awayCode: string;
  homeColor: string;
  awayColor: string;
  betType: string;
  league: string;
  date: string;
  time: string;
  confianza?: 'ALTA' | 'MEDIA' | 'BAJA';
  cuota: number;
  href?: string;
}

const {
  variant,
  homeTeam, awayTeam, homeCode, awayCode,
  homeColor, awayColor,
  betType, league, date, time,
  confianza, cuota,
  href = '#',
} = Astro.props;

const badgeColor = variant === 'SECUNDARIO' ? 'text-[#0B3D2E]' : 'text-[#0B3D2E]';

const confianzaMap = {
  ALTA:  { text: 'text-[#0B3D2E]', bars: ['h-1.5', 'h-2.5', 'h-3.5'], color: 'bg-[#0B3D2E]' },
  MEDIA: { text: 'text-amber-400', bars: ['h-1.5', 'h-2.5', 'h-1.5'], color: 'bg-amber-400' },
  BAJA:  { text: 'text-red-400',   bars: ['h-1.5', 'h-1',   'h-0.5'], color: 'bg-red-400'   },
};
const conf = confianza ? confianzaMap[confianza] : null;
---

<div class="rounded-xl border border-[#0B3D2E] p-4 flex flex-col justify-between">

  <!-- Badge -->
  <p class={`text-xs font-bold mb-3 ${badgeColor}`}>{variant}</p>

  <!-- Equipos y apuesta (layout secundario: todo en fila) -->
  {variant === 'SECUNDARIO' ? (
    <>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full flex items-center justify-center text-white text-[10px] font-bold shrink-0"
            style={`background: ${homeColor}`}
          >{homeCode}</div>
          <span class="text-gray-400 text-xs">vs</span>
          <div
            class="w-8 h-8 rounded-full flex items-center justify-center text-white text-[10px] font-bold shrink-0"
            style={`background: ${awayColor}`}
          >{awayCode}</div>
          <div class="ml-1">
            <p class="text-white text-sm font-semibold">{betType}</p>
            <p class="text-gray-400 text-xs">Tipo de apuesta</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-gray-500 text-xs">CUOTA</p>
          <p class="text-[#0B3D2E] text-2xl font-black">{cuota.toFixed(2)}</p>
        </div>
      </div>

      {conf && (
        <div class="mt-3 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class={`text-xs font-medium ${conf.text}`}>Confianza: {confianza}</span>
            <span class="flex items-end gap-0.5">
              {conf.bars.map((h) => (
                <span class={`w-1 rounded-sm inline-block ${h} ${conf.color}`}></span>
              ))}
            </span>
          </div>
          <a href={href} class="text-[#0B3D2E] text-xs hover:text-[#0A2D24] transition-colors">
            Ver análisis →
          </a>
        </div>
      )}

      <p class="text-gray-600 text-xs mt-2">{league} · {date} · {time}</p>
    </>
  ) : (
    /* Layout TERCIARIO: equipos apilados */
    <>
      <div class="flex items-center gap-2 mb-3">
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center text-white text-[10px] font-bold shrink-0"
          style={`background: ${homeColor}`}
        >{homeCode}</div>
        <span class="text-gray-400 text-xs">vs</span>
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center text-white text-[10px] font-bold shrink-0"
          style={`background: ${awayColor}`}
        >{awayCode}</div>
      </div>

      <p class="text-white text-sm font-semibold">{betType}</p>
      <p class="text-gray-500 text-xs mt-1">{league} · {date} · {time}</p>

      <div class="flex items-center justify-between mt-3">
        <div>
          <p class="text-gray-500 text-xs">CUOTA</p>
          <p class="text-[#0B3D2E] text-2xl font-black">{cuota.toFixed(2)}</p>
        </div>
        <a href={href} class="text-[#0B3D2E] text-xs hover:text-[#0A2D24] transition-colors">
          Ver análisis →
        </a>
      </div>
    </>
  )}

</div>
