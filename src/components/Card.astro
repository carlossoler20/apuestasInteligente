---
 import imagen from '../assets/logosEquipos/real-madrid-logo.png';
---
<!-- Card Principal -->
<div class="grid grid-cols-3 gap-4 py-4 border-2 border-[#0B3D2E] rounded-lg max-w-lg place-items-center bg-[#1E1E1E]">
    
    <div><img src={imagen.src} alt="Real Madrid football club crest and name with a crowned circular emblem on a white background"></div>
    
    
    
    <div><h1 class="text-white">Directa</h1><span class="text-gray-400">Real Madrid a Ganar</span></div>


    <div class="text-white">
     Cuota
     <span class="text-[#0B3D2E] font-bold">1.85</span>
    </div>

    <!-- Card Secundaria  -->
</div>
