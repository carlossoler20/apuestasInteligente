---
interface Props {
  homeTeam: string;
  awayTeam: string;
  homeCode: string;
  awayCode: string;
  homeColor: string;
  awayColor: string;
  betType: string;
  league: string;
  date: string;
  time: string;
  confianza: 'ALTA' | 'MEDIA' | 'BAJA';
  cuota: number;
  href?: string;
}

const {
  homeTeam, awayTeam, homeCode, awayCode,
  homeColor, awayColor,
  betType, league, date, time,
  confianza, cuota,
  href = '#',
} = Astro.props;

const confianzaStyle = {
  ALTA:  { text: 'text-verde-claro',  bars: ['h-1.5', 'h-2.5', 'h-3.5'], barColor: 'bg-verde-oscuro' },
  MEDIA: { text: 'text-amber-400',  bars: ['h-1.5', 'h-2.5', 'h-1.5'], barColor: 'bg-amber-400' },
  BAJA:  { text: 'text-red-400',    bars: ['h-1.5', 'h-1',   'h-0.5'], barColor: 'bg-red-400'   },
}[confianza];
---

<div class="rounded-xl border border-[#0B3D2E] p-5 mb-3 mx-auto max-w-6xl">
  <!-- Badge -->
  <p class="text-amber-400 text-s font-bold mb-3">★ PRONÓSTICO DESTACADO</p>

  <div class="flex flex-col md:flex-row md:items-center gap-5">

    <!-- Equipos -->
    <div class="flex flex-col gap-2 min-w-[170px]">
      <div class="flex items-center gap-3">
        <img
          src={`/assets/logosEquipos/${homeCode}.png`}
          alt={homeTeam}
          class="w-22 h-22 rounded-full shrink-0 m-2"
        />
        <span class="text-gray-400 text-xs">vs</span>
        <img
          src={`/assets/logosEquipos/${awayCode}.png`}
          alt={awayTeam}
          class="w-22 h-22 rounded-full shrink-0 m-2"
        />
      </div>
      <div>
        <p class="text-white text-lg font-semibold">{homeTeam} vs {awayTeam}</p>
        <p class="text-gray-400 text-s mt-0.5">{league} · {date} · {time}</p>
      </div>
    </div>

    <!-- Divisor vertical -->
    <div class="hidden md:block w-px self-stretch bg-[#0B3D2E]"></div>

    <!-- Tipo de apuesta + confianza -->
    <div class="flex-1 max-w-[250px]">
      <p class="text-white text-3xl font-bold">{betType}</p>
      <p class="text-gray-400 text-s uppercase tracking-wider mt-1">Tipo de apuesta</p>
      <div class="flex items-center gap-2 mt-3">
        <span class={`text-sm font-medium ${confianzaStyle.text}`}>
          Confianza: {confianza}
        </span>
        <span class="flex items-end gap-0.5">
          {confianzaStyle.bars.map((h) => (
            <span class={`w-1 rounded-sm inline-block ${h} ${confianzaStyle.barColor}`}></span>
          ))}
        </span>
      </div>
    </div>

     <!-- Divisor vertical -->
    <div class="hidden md:block w-px self-stretch bg-[#0B3D2E]"></div>

    <!-- analisis principal -->
    <div class="flex-1">
      <p class="text-white text-lg font-bold">Análisis Principal</p>
      <p class="text-gray-400 text-sm mt-1">Análisis detallado del partido</p>
    </div>

    <!-- Divisor vertical -->
    <div class="hidden md:block w-px self-stretch bg-[#0B3D2E]"></div>

    <!-- Cuota + CTA -->
    <div class="flex flex-col items-center gap-3 min-w-[100px]">
      <div class="text-center">
        <p class="text-gray-400 text-xs uppercase tracking-wider">Cuota</p>
        <p class="text-verde-oscuro text-4xl font-black">{cuota.toFixed(2)}</p>
      </div>
      <!-- <a
        href={href}
        class="bg-[#0B3D2E] hover:bg-[#0A2D24] text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors w-full text-center whitespace-nowrap"
      >
        Ver análisis →
      </a> -->
    </div>
  </div>
  
</div>
